APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=securevault
DB_USER=root
DB_PASS=
# Token untuk membuka /setup (ganti dengan string acak panjang)
SETUP_TOKEN=ganti-dengan-token-acak

# Kunci enkripsi kolom database (base64, 32 byte). Buat: php -r "echo base64_encode(random_bytes(32));"
# JANGAN hilang/diganti: tanpa kunci ini tipe konten dan log tidak bisa dibaca lagi.
APP_KEY=
